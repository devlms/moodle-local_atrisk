{{!
    @template local_atrisk/index

    Categories the user can see at-risk students in.

    Example context (json):
    {
        "categories": [{"name": "Science / Biology", "url": "#", "count": 3}]
    }
}}
<div class="local-atrisk">
    <ul class="list-group local-atrisk-cats">
        {{#categories}}
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <a href="{{url}}">{{{name}}}</a>
            <span class="badge local-atrisk-count">{{#str}}listed, local_atrisk, {{count}}{{/str}}</span>
        </li>
        {{/categories}}
    </ul>
</div>
